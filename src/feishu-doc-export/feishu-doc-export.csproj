<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>feishu_doc_export</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <!--版本号：每发 Release 必升级（SemVer：MAJOR.MINOR.PATCH），
        会同时写入 AssemblyVersion / FileVersion / InformationalVersion，
        以及 Win-x64 exe 的"文件详细信息 → 产品版本"字段。
        变更历史见 change.log -->
    <Version>0.1.0</Version>
  </PropertyGroup>


  <ItemGroup>
    <!--允许单元测试项目访问 internal 成员-->
    <InternalsVisibleTo Include="feishu-doc-export.Tests" />
    <!--Docx → Markdown 转换（MIT 无水印，0.16.0 为最后一版支持 .NET 6）-->
    <PackageReference Include="DocSharp.Docx" Version="0.16.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="3.1.32" />
    <PackageReference Include="Newtonsoft.Json" Version="*" />
    <PackageReference Include="WebApiClientCore" Version="2.0.4" />
    <PackageReference Include="WebApiClientCore.Extensions.OAuths" Version="2.0.4" />
  </ItemGroup>


</Project>
